class Solution {
public:
    int minMoves(vector<int>& nums) {
        int n = nums.size();

        int smallest = INT_MAX;
        for(int i  = 0;i<n;i++){
            if(nums[i]<smallest){
            smallest = nums[i];
        }
        }
       int ans = 0;
       for(int i =0;i<n;i++){
        ans  = ans +nums[i]- smallest;
       }
              return ans;

    }
};