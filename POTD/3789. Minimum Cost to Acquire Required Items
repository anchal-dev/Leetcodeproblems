
class Solution {
public:
    long long minimumCost(int cost1, int cost2, int costBoth,
                          int need1, int need2) {

        long long both = min(need1, need2);
        long long remaining1 = need1 - both;
        long long remaining2 = need2 - both;

        long long option1 = both * costBoth
                         + remaining1 * cost1
                         + remaining2 * cost2;

        long long option2 = 1LL * max(need1, need2) * costBoth;

        long long option3 = 1LL * need1 * cost1
                         + 1LL * need2 * cost2;

        return min({option1, option2, option3});
    }
};
