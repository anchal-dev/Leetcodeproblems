class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {
        unordered_map<int,int>mp;
        int n =nums.size();
        int i =0;
        int j =k-1;
       while(j<n){
        unordered_set<int>st;
        for(int k=i;k<=j;k++){
          st.insert(nums[k]);
        }

        for(int num:st){
            mp[num]++;
        }

        j++;
        i++;

       }
       int ans = -1;
        for( auto &num:mp){
            if(num.second== 1){
                ans = max(ans ,num.first);

            }
        }
        return ans;

        
    }
};