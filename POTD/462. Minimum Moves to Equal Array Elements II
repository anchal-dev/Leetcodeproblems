class Solution {
public:
    int minMoves2(vector<int>& nums) {
        int n = nums.size();
        sort(nums.begin() , nums.end());
     
           int median = n/2;

        int medianele = nums[median];
        int ans =0;
        for(int i = 0;i<n;i++){
            if(nums[i]<medianele){
                ans =medianele-nums[i] +ans;
            }
            else{
                ans = nums[i]- medianele+ ans;
            }
        }
        return  ans;


    }
};